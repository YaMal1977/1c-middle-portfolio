		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	СтруктураПредприятия.Ссылка КАК Подразделение,
	СтруктураПредприятия.Родитель КАК Родитель
ПОМЕСТИТЬ ВтПодразделения
ИЗ
	Справочник.СтруктураПредприятия КАК СтруктураПредприятия
ГДЕ
	СтруктураПредприятия.Ссылка В(&amp;СписокПодразделений)

ИНДЕКСИРОВАТЬ ПО
	Подразделение
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗЛИЧНЫЕ
	ПланПродажТовары.Номенклатура КАК Номенклатура,
	СУММА(ПланПродажТовары.Количество) КАК Количество,
	МИНИМУМ(ПланПродажТовары.НомерСтроки) КАК НомерСтроки,
	ПланПродажТовары.ДатаОтгрузки КАК Период,
	ПланПродаж.Ссылка КАК Док
ИЗ
	Документ.ПланПродаж КАК ПланПродаж
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПланПродаж.Товары КАК ПланПродажТовары
		ПО ПланПродаж.Ссылка = ПланПродажТовары.Ссылка
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВтПодразделения КАК ВтПодразделения
		ПО ПланПродаж.Подразделение = ВтПодразделения.Подразделение
ГДЕ
	ПланПродаж.Проведен = ИСТИНА
	И ПланПродаж.НачалоПериода &lt;= &amp;ОкончаниеПериода
	И ПланПродаж.ОкончаниеПериода &gt;= &amp;НачалоПериода
	И ПланПродаж.Подразделение В
			(ВЫБРАТЬ
				ВтПодразделения.Подразделение КАК Подразделение
			ИЗ
				ВтПодразделения КАК ВтПодразделения)

СГРУППИРОВАТЬ ПО
	ПланПродажТовары.Номенклатура,
	ПланПродажТовары.ДатаОтгрузки,
	ПланПродаж.Ссылка

УПОРЯДОЧИТЬ ПО
	НомерСтроки</query>
